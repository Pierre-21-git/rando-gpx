<?xml version="1.0" encoding="utf-8"?>
<!-- Surcharge du foreground pour le build debug uniquement (voir app/src/main pour la
     version release) : même silhouette de montagne, plus un bandeau "DEBUG" superposé
     pour distinguer les deux variantes au premier coup d'œil sur l'écran d'accueil. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M26,78 L46,44 L58,60 L70,40 L82,78 Z" />
            <path
                android:fillColor="#D98E4A"
                android:pathData="M54,30 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
        </vector>
    </item>
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="fill">
        <bitmap
            android:src="@drawable/debug_ribbon"
            android:gravity="fill" />
    </item>
</layer-list>
